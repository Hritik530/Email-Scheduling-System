# ==============================================================================
# ReachInbox Email Job Scheduler - Environment Configuration
# Copy this file to .env and fill in your credentials before running.
# ==============================================================================

NODE_ENV=development
PORT=4000

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_db?schema=public

# Redis (BullMQ & Distributed Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth 2.0 (https://api.slack.com/apps)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Security & Encryption
# Generate strong random strings for production (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-this-to-a-long-random-session-secret-at-least-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Default / Fallback Ethereal SMTP Configuration (https://ethereal.email/)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user@ethereal.email
ETHEREAL_PASS=your-ethereal-password

# BullMQ Worker & Rate Limiter Configuration
WORKER_CONCURRENCY=5
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5000
DEFAULT_EMAIL_DELAY=2000
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Frontend Build Configuration
VITE_API_URL=http://localhost:4000
