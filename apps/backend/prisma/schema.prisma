generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
  cancelled
}

enum CampaignStatus {
  scheduled
  in_progress
  completed
  partial
  cancelled
}

enum OutboxStatus {
  pending
  published
  failed
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders          EmailSender[]
  campaigns        EmailCampaign[]
  scheduledEmails  ScheduledEmail[]
  slackIntegration SlackIntegration?

  @@index([email])
}

model EmailSender {
  id                    String   @id @default(cuid())
  userId                String
  email                 String
  smtpHost              String
  smtpPort              Int
  smtpUsername          String
  encryptedSmtpPassword String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns       EmailCampaign[]
  scheduledEmails ScheduledEmail[]

  @@unique([userId, email])
  @@index([userId, isActive])
}

model EmailCampaign {
  id                 String         @id @default(cuid())
  userId             String
  senderId           String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int
  hourlyLimit        Int
  idempotencyKey     String?
  status             CampaignStatus @default(scheduled)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          EmailSender      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  scheduledEmails ScheduledEmail[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([senderId])
}

model ScheduledEmail {
  id                 String      @id @default(cuid())
  campaignId         String
  userId             String
  senderId           String
  recipientEmail     String
  subject            String
  body               String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus @default(scheduled)
  attempts           Int         @default(0)
  errorMessage       String?
  smtpMessageId      String?
  etherealPreviewUrl String?
  idempotencyKey     String      @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   EmailSender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([userId, status, scheduledAt])
  @@index([userId, status, sentAt])
  @@index([campaignId, status])
  @@index([senderId, scheduledAt])
  @@index([status, scheduledAt])
}

model SlackIntegration {
  id                   String   @id @default(cuid())
  userId               String   @unique
  teamId               String
  teamName             String
  channelId            String?
  channelName          String?
  encryptedAccessToken String
  encryptedWebhookUrl  String?
  isConnected          Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  lastError     String?
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
}
